import sys
import time

def texto_pausado(texto, atraso=0.02):
    """
    Função utilitária para exibir o texto aos poucos no terminal,
    criando um efeito de narrativa interativa.
    """
    for letra in texto:
        sys.stdout.write(letra)
        sys.stdout.flush()
        time.sleep(atraso)
    print()

def obter_escolha(opcoes_validas):
    """
    Garante que o jogador digite uma opção válida (ex: 1, 2 ou 3).
    """
    while True:
        escolha = input("\nSua escolha: ").strip()
        if escolha in opcoes_validas:
            return escolha
        print("Opção inválida! Digite o número correspondente à sua decisão.")

def iniciar_jogo():
