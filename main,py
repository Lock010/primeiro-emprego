    # -------------------------------------------------------------------------
    # DECISÃO 3: Pergunta do Candidato
    # -------------------------------------------------------------------------
    print("\n--- CENA 3: O Final da Entrevista ---")
    texto_pausado("Sr. Silva: 'Certo, encerramos por aqui. Você tem alguma pergunta para mim?'")
    print("\nO que você pergunta?")
    print("1. 'Quais são os principais desafios da equipe neste trimestre e como essa vaga impacta isso?'")
    print("2. 'Qual é a política da empresa sobre folgas e banco de horas?'")
